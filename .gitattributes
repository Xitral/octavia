# Keep line endings LF everywhere (the self-improvement builder works in git worktrees, and
# core.autocrlf=true would otherwise check those out with CRLF).
* text=auto eol=lf

*.onnx binary
*.npy binary
*.wav binary
*.png binary
*.ico binary
*.exe binary
*.reg text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf
