# Copy this file to .env (git ignores it) and fill in the keys you use. Only the Fish Audio key is required.
# Values go straight after the =, on the same line; quotes are fine but not needed.
# `uv run octavia env` checks this file, and `uv run octavia env tidy` sorts yours into these sections.
# Claude needs nothing here: sign the assistant in once with `uv run octavia login`.

# ---- Voice ----
# Her voice (Fish Audio). Required.
FISH_AUDIO_API_KEY=
# Optional: which voice she speaks with (32 hex characters), from https://fish.audio/app/discovery or your own cloned
# voice. tts.fish_audio.reference_id in config/local.yaml wins over it.
FISH_AUDIO_VOICE_ID=

# ---- Brain ----
# Only with brain.claude.auth: api_key in config/local.yaml. Otherwise leave it out: it would bill the API instead of
# using your Claude subscription (sign in once with: uv run octavia login).
# ANTHROPIC_API_KEY=
# Only with brain.provider: openai_compatible: the key of that model's server (OpenAI, or any server speaking its
# API). brain.openai_compatible.api_key_env can name another variable instead (GEMINI_API_KEY, ...).
# OPENAI_API_KEY=

# ---- Integrations ----
# TickTick (tasks, lists, habits): TickTick on the web, your avatar, Settings, Account & Security, API Token.
TICKTICK_API_TOKEN=
# Canvas (coursework, due dates, grades): in Canvas, Account, Settings, '+ New Access Token'.
CANVAS_API_TOKEN=
# Your school's Canvas address, e.g. https://yourschool.instructure.com (needed with the token).
CANVAS_BASE_URL=
# Gmail (new-mail alerts, reading the inbox): your Gmail address...
GMAIL_ADDRESS=
# ...and an app password for it (myaccount.google.com/apppasswords, needs 2-Step Verification); never your usual
# password. Only used to read the inbox.
GMAIL_APP_PASSWORD=
# Your calendars' private iCal addresses, all on this one line, separated by spaces (Google Calendar: Settings, the
# calendar's name, 'Secret address in iCal format').
CALENDAR_ICS_URLS=
# Reading your Spotify playlists: a free app at developer.spotify.com/dashboard with the Web API and the redirect URI
# http://127.0.0.1:8898/callback. Then ask her to connect Spotify.
SPOTIFY_CLIENT_ID=
# Naming the song that's playing: a free AudD token from dashboard.audd.io.
AUDD_API_TOKEN=
# Texting her from your phone: your own Discord bot's token (discord.com/developers/applications, your app, Bot, Reset
# Token), with discord_bridge.enabled: true in config/local.yaml. See docs/discord-bridge.md.
DISCORD_BOT_TOKEN=
# ...and your own numeric Discord user ID (Developer Mode on, right-click yourself, Copy User ID), unless
# discord_bridge.owner_id says it. Only that account is ever answered.
DISCORD_OWNER_ID=

# ---- Maps ----
# Optional: photorealistic 3D cities and terrain in God's Eye View, a free Cesium ion token (ion.cesium.com, Access
# Tokens). Without one it shows flat satellite imagery.
CESIUM_ION_TOKEN=
# Optional: Google's photorealistic 3D tiles and place search in God's Eye View (console.cloud.google.com, Map Tiles
# API; billing required, so set a budget).
GOOGLE_MAPS_API_KEY=

# ---- Advanced ----
# Another settings file to use instead of config/local.yaml.
# OCTAVIA_CONFIG=
# Where the speech models live, if not in models/.
# OCTAVIA_MODELS_DIR=

# OCTAVIA_HOME (which folder is hers) can't go in here: set it as a Windows environment variable.
